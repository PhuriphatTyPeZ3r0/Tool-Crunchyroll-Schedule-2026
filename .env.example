# Crunchyroll public web client credentials (base64 of "clientid:secret")
# This is the public web client, not a personal secret.
BASIC_AUTH_TOKEN=bm9haWhkZXZtXzZpeWcwYThsMHE6

# Your personal account refresh token (SECRET — never commit).
# Obtain from DevTools: POST auth/v1/token response, "refresh_token" field.
REFRESH_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Locale / audio preferences for the schedule data.
LOCALE=th-TH
PREFERRED_AUDIO_LANGUAGE=th-TH

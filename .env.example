# Season window (ISO dates, UTC). Default = Summer 2026.
SEASON_START=2026-06-28T00:00:00Z
SEASON_END=2026-09-30T23:59:59Z

# true  = only shows streaming on Crunchyroll
# false = every airing anime in the window (links to AniList when no CR link)
CR_ONLY=true

# How long a built feed is served before refreshing (ms). Default 1h.
CACHE_TTL_MS=3600000

# Port (Render sets PORT automatically).
PORT=3000
